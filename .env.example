# Copy to .env and adjust. Docker Compose sets these for the containers itself;
# this file is for running the API / worker / tests directly on your machine.

# PostgreSQL (SQLAlchemy URL using the psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://flowgrid:flowgrid@localhost:5432/flowgrid

# Redis, used as the Celery message broker
REDIS_URL=redis://localhost:6379/0

# Logging level for API and worker
LOG_LEVEL=INFO
