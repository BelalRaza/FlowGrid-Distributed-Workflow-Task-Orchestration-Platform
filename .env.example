# Copy to .env and adjust. Docker Compose sets these for the containers itself;
# this file is for running the API / worker / tests directly on your machine.

# PostgreSQL (SQLAlchemy URL using the psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://flowgrid:flowgrid@localhost:5432/flowgrid

# Redis, used as the Celery message broker
REDIS_URL=redis://localhost:6379/0

# Logging: level, and format ("text" for humans, "json" for log aggregation)
LOG_LEVEL=INFO
LOG_FORMAT=text

# Retries: exponential backoff with jitter, capped
DEFAULT_MAX_ATTEMPTS=3
MAX_ALLOWED_ATTEMPTS=10
RETRY_BASE_DELAY_SECONDS=2
RETRY_MAX_DELAY_SECONDS=300

# Timeouts and leases (each job type has its own default timeout). A RUNNING
# job is presumed abandoned once
# started_at + timeout_seconds + LEASE_GRACE_SECONDS has passed
MAX_TIMEOUT_SECONDS=600
LEASE_GRACE_SECONDS=15

# Sweeper (python -m app.sweeper)
SWEEP_INTERVAL_SECONDS=1
SWEEP_BATCH_SIZE=100
PENDING_REPUBLISH_AFTER_SECONDS=10
# QUEUED jobs older than this are re-published in case Redis lost the message.
# Keep it above your normal worst-case queue wait (duplicates are harmless but wasteful).
QUEUED_REPUBLISH_AFTER_SECONDS=300

# Idempotency keys are honoured for this long
IDEMPOTENCY_KEY_TTL_HOURS=24

# Rate limiting: token bucket per API key
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_PER_SECOND=20

# Requests larger than this are rejected with 413
MAX_REQUEST_BODY_BYTES=1000000

# Batch endpoint: max jobs per request
MAX_BATCH_SIZE=500

# Live events (SSE): keepalive interval (also how often a stream re-checks its
# API key) and per-client buffer before a slow client gets a "resync" event
SSE_KEEPALIVE_SECONDS=15
SSE_QUEUE_SIZE=1000
